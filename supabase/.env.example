# Secrets for the edge functions: `npx supabase secrets set --env-file supabase/.env`
# All three may be left empty for MOCK MODE: typed requests are then understood by keyword rules
# (spoken requests need SARVAM_API_KEY; the scam check needs OPENAI_API_KEY). See AGENTS.md section 2.
SARVAM_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=                     # optional now: only used for screen recordings
# Optional
# LLM_PROVIDER=openai               # or gemini (default: openai when OPENAI_API_KEY is set)
# OPENAI_MODEL=gpt-4.1-mini
# GEMINI_MODEL=gemini-2.5-flash
# SARVAM_STT_MODEL=saarika:v2.5
# WHISPER_MODEL=whisper-1
# BUJJI_STT_PROVIDER=sarvam        # or indicconformer
# INDIC_ASR_URL=https://your-indicconformer-server/transcribe
# SARVAM_TTS_SPEAKER=kavitha        # bulbul:v3 voice
