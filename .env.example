# App settings (public values only; API keys live in Supabase secrets).
# OFFLINE DEMO MODE: leave EXPO_PUBLIC_SUPABASE_URL empty (or keep the placeholder) or set EXPO_PUBLIC_MOCK=1.
# The app then runs with built-in demo data and no accounts or keys. See BUJJI.md.
EXPO_PUBLIC_MOCK=1
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_FAMILY_ID=demo-1
